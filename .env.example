# TEMPLATE ONLY — this file IS committed to git. Never put real credentials here.
# Copy to .env (which is gitignored) and fill that in instead.

GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password

# Where the cached auth token lives. Defaults to ~/.garminconnect.
# After the first --login run, the password is only needed again when the
# token expires (every few months, or whenever Garmin changes SSO).
# GARMINTOKENS=/home/youruser/.garminconnect
